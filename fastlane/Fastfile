default_platform(:android)

# :app, :wearos and :tv all share one applicationId, so Play sees a single listing with three
# form factors and every release has to carry all three artifacts — shipping one alone drops the
# other two from that track. Play routes them by uses-feature: leanback to TV, watch to Wear OS,
# and the phone build to everything else.
#
# Smart deploy: if a module's versionCode hasn't changed since the last git tag, its AAB is NOT
# rebuilt. Instead, version_codes_to_retain tells the Play Store API to keep the existing version
# on the target track. This cuts CI time significantly when only one or two modules have changes.
PHONE_AAB = "app/build/outputs/bundle/playRelease/app-play-release.aab"
WEAR_AAB  = "wearos/build/outputs/bundle/release/wearos-release.aab"
TV_AAB    = "tv/build/outputs/bundle/playRelease/tv-play-release.aab"

platform :android do

  desc "Run tests"
  lane :test do
    gradle(task: "test")
  end

  desc "Build debug APK"
  lane :build_debug do
    gradle(task: ":app:assembleOpensourceDebug")
  end

  desc "Build release AAB for Play"
  lane :build_release do
    gradle(task: ":app:bundlePlayRelease")
  end

  desc "Build release APK for GitHub / F-Droid distribution"
  lane :build_full_release do
    gradle(task: ":app:assembleOpensourceRelease")
  end

  # ---------------------------------------------------------------------------
  # Deploy lanes — all use smart_deploy internally
  # ---------------------------------------------------------------------------

  desc "Deploy to internal testing track (skips building modules with no version bump)"
  lane :internal do
    smart_deploy(track: "internal", skip_screenshots: true, release_status: "completed")
  end

  desc "Deploy to closed testing (beta) track (skips building modules with no version bump)"
  lane :beta do
    smart_deploy(track: "beta", skip_screenshots: true, release_status: "completed")
  end

  desc "Deploy to production track as draft (skips building modules with no version bump)"
  lane :production do
    smart_deploy(track: "production", skip_screenshots: false, release_status: "draft")
  end

  # ---------------------------------------------------------------------------
  # Version bump helpers
  # ---------------------------------------------------------------------------

  desc "Increment app versionCode and set versionName"
  lane :bump_version do |options|
    version_name = options[:version] || "1.0"
    build_gradle = File.read("../app/build.gradle.kts")
    current_code = build_gradle.match(/versionCode = (\d+)/)[1].to_i
    new_code     = current_code + 1
    new_content  = build_gradle
                     .gsub(/versionCode = \d+/, "versionCode = #{new_code}")
                     .gsub(/versionName = ".*"/, "versionName = \"#{version_name}\"")
    File.write("../app/build.gradle.kts", new_content)
    UI.success("✅ App bumped to versionCode=#{new_code}, versionName=#{version_name}")
  end

  desc "Increment WearOS versionCode and set versionName"
  lane :bump_version_wear do |options|
    version_name = options[:version] || "1.0"
    build_gradle = File.read("../wearos/build.gradle.kts")
    current_code = build_gradle.match(/versionCode = (\d+)/)[1].to_i
    new_code     = current_code + 1
    new_content  = build_gradle
                     .gsub(/versionCode = \d+/, "versionCode = #{new_code}")
                     .gsub(/versionName = ".*"/, "versionName = \"#{version_name}\"")
    File.write("../wearos/build.gradle.kts", new_content)
    UI.success("✅ WearOS bumped to versionCode=#{new_code}, versionName=#{version_name}")
  end

  desc "Increment TV versionCode and set versionName"
  lane :bump_version_tv do |options|
    version_name = options[:version] || "1.0"
    build_gradle = File.read("../tv/build.gradle.kts")
    current_code = build_gradle.match(/versionCode = (\d+)/)[1].to_i
    new_code     = current_code + 1
    new_content  = build_gradle
                     .gsub(/versionCode = \d+/, "versionCode = #{new_code}")
                     .gsub(/versionName = ".*"/, "versionName = \"#{version_name}\"")
    File.write("../tv/build.gradle.kts", new_content)
    UI.success("✅ TV bumped to versionCode=#{new_code}, versionName=#{version_name}")
  end

  # ---------------------------------------------------------------------------
  # Private helpers
  # ---------------------------------------------------------------------------

  # Read versionCode directly from a module's build.gradle.kts on disk.
  private_lane :read_version_code do |options|
    file = File.read("../#{options[:module]}/build.gradle.kts")
    match = file.match(/versionCode = (\d+)/)
    match ? match[1].to_i : 0
  end

  # Find the previous git tag before the current commit/tag.
  private_lane :previous_tag do
    # On a tagged commit (e.g. CI building v1.13.1), `git describe --tags --abbrev=0` returns v1.13.1.
    # To get the tag BEFORE the current commit, use HEAD^.
    tag = sh("git describe --tags --abbrev=0 HEAD^ 2>/dev/null || echo ''").strip
    if tag.empty?
      current = sh("git describe --tags --abbrev=0 2>/dev/null || echo ''").strip
      tags = sh("git tag -l --sort=-v:refname 'v*' 2>/dev/null || echo ''").split("\n").map(&:strip)
      tag = tags.find { |t| t != current && !t.empty? } || ""
    end
    tag
  end

  # Read versionCode as it was at the previous git tag.
  private_lane :tagged_version_code do |options|
    prev_tag = previous_tag
    if prev_tag.empty?
      UI.important("⚠️ Could not determine previous git tag, defaulting to 0 for #{options[:module]}")
      0
    else
      content = sh("git show #{prev_tag}:#{options[:module]}/build.gradle.kts 2>/dev/null || echo ''").strip
      match = content.match(/versionCode = (\d+)/)
      match ? match[1].to_i : 0
    end
  end

  # Smart deploy: build and upload only modules whose versionCode changed since the previous tag.
  # Uploads each changed form factor independently to avoid combining them into a single release payload.
  private_lane :smart_deploy do |options|
    uploaded_any = false

    # --- Phone ---
    phone_now     = read_version_code(module: "app")
    phone_last    = tagged_version_code(module: "app")
    phone_changed = phone_now != phone_last
    UI.message("📱 Phone versionCode: last=#{phone_last} now=#{phone_now} → #{phone_changed ? 'BUILDING & UPLOADING' : 'SKIPPING (no change)'}")
    if phone_changed
      gradle(task: ":app:bundlePlayRelease")
      upload_to_play_store(
        track:                   options[:track],
        package_name:            "app.pwhs.universalinstaller",
        aab:                     PHONE_AAB,
        json_key:                "fastlane/play-store-key.json",
        skip_upload_metadata:    true,
        skip_upload_images:      true,
        skip_upload_screenshots: true,
        skip_upload_changelogs:  false,
        release_status:          options[:release_status],
      )
      uploaded_any = true
    end

    # --- WearOS ---
    wear_now     = read_version_code(module: "wearos")
    wear_last    = tagged_version_code(module: "wearos")
    wear_changed = wear_now != wear_last
    UI.message("⌚ WearOS versionCode: last=#{wear_last} now=#{wear_now} → #{wear_changed ? 'BUILDING & UPLOADING' : 'SKIPPING (no change)'}")
    if wear_changed
      gradle(task: ":wearos:bundleRelease")
      upload_to_play_store(
        track:                   options[:track],
        package_name:            "app.pwhs.universalinstaller",
        aab:                     WEAR_AAB,
        json_key:                "fastlane/play-store-key.json",
        skip_upload_metadata:    true,
        skip_upload_images:      true,
        skip_upload_screenshots: true,
        skip_upload_changelogs:  false,
        release_status:          options[:release_status],
      )
      uploaded_any = true
    end

    # --- TV ---
    tv_now     = read_version_code(module: "tv")
    tv_last    = tagged_version_code(module: "tv")
    tv_changed = tv_now != tv_last
    UI.message("📺 TV versionCode: last=#{tv_last} now=#{tv_now} → #{tv_changed ? 'BUILDING & UPLOADING' : 'SKIPPING (no change)'}")
    if tv_changed
      gradle(task: ":tv:bundlePlayRelease")
      upload_to_play_store(
        track:                   options[:track],
        package_name:            "app.pwhs.universalinstaller",
        aab:                     TV_AAB,
        json_key:                "fastlane/play-store-key.json",
        skip_upload_metadata:    true,
        skip_upload_images:      true,
        skip_upload_screenshots: true,
        skip_upload_changelogs:  false,
        release_status:          options[:release_status],
      )
      uploaded_any = true
    end

    if !uploaded_any
      UI.important("⚠️ No AABs had version code bumps! Fallback: building and uploading phone AAB.")
      gradle(task: ":app:bundlePlayRelease")
      upload_to_play_store(
        track:                   options[:track],
        package_name:            "app.pwhs.universalinstaller",
        aab:                     PHONE_AAB,
        json_key:                "fastlane/play-store-key.json",
        skip_upload_metadata:    true,
        skip_upload_images:      true,
        skip_upload_screenshots: true,
        skip_upload_changelogs:  false,
        release_status:          options[:release_status],
      )
    end
  end

end
