default_platform(:android)

# :wearos shares :app's applicationId, so Play sees one listing with two form factors and a
# release must carry both artifacts — uploading the phone AAB alone would drop the watch build
# from the track, and the watch AAB alone would drop the phone build.
PHONE_AAB = "app/build/outputs/bundle/playRelease/app-play-release.aab"
WEAR_AAB = "wearos/build/outputs/bundle/release/wearos-release.aab"

platform :android do

  desc "Run tests"
  lane :test do
    gradle(task: "test")
  end

  desc "Build debug APK"
  lane :build_debug do
    gradle(task: ":app:assembleOpensourceDebug")
  end

  desc "Build release AAB for Play"
  lane :build_release do
    gradle(task: ":app:bundlePlayRelease")
  end

  desc "Build release APK for GitHub distribution"
  lane :build_full_release do
    gradle(task: ":app:assembleOpensourceRelease")
  end

  desc "Deploy internal testing track"
  lane :internal do
    gradle(task: ":app:bundlePlayRelease")
    gradle(task: ":wearos:bundleRelease")
    upload_to_play_store(
      track: "internal",
      package_name: "app.pwhs.universalinstaller",
      aab_paths: [PHONE_AAB, WEAR_AAB],
      json_key: "fastlane/play-store-key.json",
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: true,
      skip_upload_changelogs: false,
    )
  end

  desc "Deploy to closed testing track"
  lane :beta do
    gradle(task: ":app:bundlePlayRelease")
    gradle(task: ":wearos:bundleRelease")
    upload_to_play_store(
      track: "beta",
      package_name: "app.pwhs.universalinstaller",
      aab_paths: [PHONE_AAB, WEAR_AAB],
      json_key: "fastlane/play-store-key.json",
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: true,
      skip_upload_changelogs: false,
    )
  end

  desc "Deploy to production"
  lane :production do
    gradle(task: ":app:bundlePlayRelease")
    gradle(task: ":wearos:bundleRelease")
    upload_to_play_store(
      track: "production",
      package_name: "app.pwhs.universalinstaller",
      aab_paths: [PHONE_AAB, WEAR_AAB],
      json_key: "fastlane/play-store-key.json",
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: false,
      release_status: "draft"
    )
  end

  desc "Deploy TV to internal testing track"
  lane :internal_tv do
    gradle(task: ":tv:bundleRelease")
    upload_to_play_store(
      track: "internal",
      package_name: "app.pwhs.universalinstaller.tv",
      aab: "tv/build/outputs/bundle/release/tv-release.aab",
      json_key: "fastlane/play-store-key.json",
      metadata_path: "./fastlane_tv/metadata/android",
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: true,
      skip_upload_changelogs: false,
    )
  end

  desc "Deploy TV to closed testing track"
  lane :beta_tv do
    gradle(task: ":tv:bundleRelease")
    upload_to_play_store(
      track: "beta",
      package_name: "app.pwhs.universalinstaller.tv",
      aab: "tv/build/outputs/bundle/release/tv-release.aab",
      json_key: "fastlane/play-store-key.json",
      metadata_path: "./fastlane_tv/metadata/android",
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: true,
      skip_upload_changelogs: false,
    )
  end

  desc "Deploy TV to production"
  lane :production_tv do
    gradle(task: ":tv:bundleRelease")
    upload_to_play_store(
      track: "production",
      package_name: "app.pwhs.universalinstaller.tv",
      aab: "tv/build/outputs/bundle/release/tv-release.aab",
      json_key: "fastlane/play-store-key.json",
      metadata_path: "./fastlane_tv/metadata/android",
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: false,
      release_status: "draft"
    )
  end

  desc "Increment version code"
  lane :bump_version do |options|
    version_name = options[:version] || "1.0"
    # Read current versionCode from build.gradle.kts
    build_gradle = File.read("../app/build.gradle.kts")
    current_code = build_gradle.match(/versionCode = (\d+)/)[1].to_i
    new_code = current_code + 1

    # Update versionCode
    new_content = build_gradle.gsub(
      /versionCode = \d+/,
      "versionCode = #{new_code}"
    )
    # Update versionName if provided
    new_content = new_content.gsub(
      /versionName = ".*"/,
      "versionName = \"#{version_name}\""
    )
    File.write("../app/build.gradle.kts", new_content)

    UI.success("✅ Bumped to versionCode=#{new_code}, versionName=#{version_name}")
  end

  desc "Increment TV version code"
  lane :bump_version_tv do |options|
    version_name = options[:version] || "1.0"
    build_gradle = File.read("../tv/build.gradle.kts")
    current_code = build_gradle.match(/versionCode = (\d+)/)[1].to_i
    new_code = current_code + 1

    new_content = build_gradle.gsub(
      /versionCode = \d+/,
      "versionCode = #{new_code}"
    )
    new_content = new_content.gsub(
      /versionName = ".*"/,
      "versionName = \"#{version_name}\""
    )
    File.write("../tv/build.gradle.kts", new_content)

    UI.success("✅ TV bumped to versionCode=#{new_code}, versionName=#{version_name}")
  end
end
