default_platform(:android)

# :tv shares :app's applicationId, so a Play release has to carry every form factor's artifact.
# Smart deploy: if a module's versionCode hasn't changed since the last git tag, its AAB is NOT
# rebuilt. Instead, version_codes_to_retain tells Play Store to keep the existing version.
PHONE_AAB = "app/build/outputs/bundle/playRelease/app-play-release.aab"
WEAR_AAB  = "wearos/build/outputs/bundle/release/wearos-release.aab"
TV_AAB    = "tv/build/outputs/bundle/release/tv-release.aab"

platform :android do

  desc "Run tests"
  lane :test do
    gradle(task: "test")
  end

  desc "Build TV debug APK"
  lane :build_debug do
    gradle(task: ":tv:assembleDebug")
  end

  desc "Build TV release AAB for Play"
  lane :build_release do
    gradle(task: ":tv:bundleRelease")
  end

  desc "Build TV release APK for GitHub distribution"
  lane :build_full_release do
    gradle(task: ":tv:assembleRelease")
  end

  # ---------------------------------------------------------------------------
  # Deploy lanes
  # ---------------------------------------------------------------------------

  desc "Deploy every form factor to internal testing track (skips modules with no version bump)"
  lane :internal do
    smart_deploy(track: "internal", skip_screenshots: true, release_status: "completed")
  end

  desc "Deploy every form factor to closed testing track (skips modules with no version bump)"
  lane :beta do
    smart_deploy(track: "beta", skip_screenshots: true, release_status: "completed")
  end

  desc "Deploy every form factor to production as draft (skips modules with no version bump)"
  lane :production do
    smart_deploy(track: "production", skip_screenshots: false, release_status: "draft")
  end

  # ---------------------------------------------------------------------------
  # Version bump helper
  # ---------------------------------------------------------------------------

  desc "Increment TV versionCode and set versionName"
  lane :bump_version do |options|
    version_name = options[:version] || "1.0"
    build_gradle = File.read("../tv/build.gradle.kts")
    current_code = build_gradle.match(/versionCode = (\d+)/)[1].to_i
    new_code     = current_code + 1

    new_content = build_gradle.gsub(
      /versionCode = \d+/,
      "versionCode = #{new_code}"
    )
    new_content = new_content.gsub(
      /versionName = ".*"/,
      "versionName = \"#{version_name}\""
    )
    File.write("../tv/build.gradle.kts", new_content)

    UI.success("✅ TV bumped to versionCode=#{new_code}, versionName=#{version_name}")
  end

  # ---------------------------------------------------------------------------
  # Private helpers
  # ---------------------------------------------------------------------------

  private_lane :read_version_code do |options|
    file = File.read("../#{options[:module]}/build.gradle.kts")
    match = file.match(/versionCode = (\d+)/)
    match ? match[1].to_i : 0
  end

  private_lane :previous_tag do
    tag = sh("git describe --tags --abbrev=0 HEAD^ 2>/dev/null || echo ''").strip
    if tag.empty?
      current = sh("git describe --tags --abbrev=0 2>/dev/null || echo ''").strip
      tags = sh("git tag -l --sort=-v:refname 'v*' 2>/dev/null || echo ''").split("\n").map(&:strip)
      tag = tags.find { |t| t != current && !t.empty? } || ""
    end
    tag
  end

  private_lane :tagged_version_code do |options|
    prev_tag = previous_tag
    if prev_tag.empty?
      UI.important("⚠️ Could not determine previous git tag, defaulting to 0 for #{options[:module]}")
      0
    else
      content = sh("git show #{prev_tag}:#{options[:module]}/build.gradle.kts 2>/dev/null || echo ''").strip
      match = content.match(/versionCode = (\d+)/)
      match ? match[1].to_i : 0
    end
  end

  private_lane :smart_deploy do |options|
    aab_paths    = []
    retain_codes = []

    # --- Phone ---
    phone_now     = read_version_code(module: "app")
    phone_last    = tagged_version_code(module: "app")
    phone_changed = phone_now != phone_last
    UI.message("📱 Phone versionCode: last=#{phone_last} now=#{phone_now} → #{phone_changed ? 'BUILDING' : 'SKIPPING (no change)'}")
    if phone_changed
      gradle(task: ":app:bundlePlayRelease")
      aab_paths << PHONE_AAB
    else
      retain_codes << phone_now
    end

    # --- WearOS ---
    wear_now     = read_version_code(module: "wearos")
    wear_last    = tagged_version_code(module: "wearos")
    wear_changed = wear_now != wear_last
    UI.message("⌚ WearOS versionCode: last=#{wear_last} now=#{wear_now} → #{wear_changed ? 'BUILDING' : 'SKIPPING (no change)'}")
    if wear_changed
      gradle(task: ":wearos:bundleRelease")
      aab_paths << WEAR_AAB
    else
      retain_codes << wear_now
    end

    # --- TV ---
    tv_now     = read_version_code(module: "tv")
    tv_last    = tagged_version_code(module: "tv")
    tv_changed = tv_now != tv_last
    UI.message("📺 TV versionCode: last=#{tv_last} now=#{tv_now} → #{tv_changed ? 'BUILDING' : 'SKIPPING (no change)'}")
    if tv_changed
      gradle(task: ":tv:bundleRelease")
      aab_paths << TV_AAB
    else
      retain_codes << tv_now
    end

    if aab_paths.empty?
      UI.important("⚠️ No AABs had version code bumps! Fallback: building TV AAB.")
      gradle(task: ":tv:bundleRelease")
      aab_paths << TV_AAB
      retain_codes.delete(tv_now)
    end

    upload_to_play_store(
      track:                   options[:track],
      package_name:            "app.pwhs.universalinstaller",
      aab:                     TV_AAB,
      json_key:                "fastlane/play-store-key.json",
      metadata_path:           "./fastlane/metadata/android",
      skip_upload_metadata:    true,
      skip_upload_images:      true,
      skip_upload_screenshots: true,
      skip_upload_changelogs:  false,
      release_status:          options[:release_status],
    )
  end

end
