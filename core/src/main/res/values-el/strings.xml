    <string name="onboarding_virustotal_paste">Επικόλληση από το πρόχειρο</string>
    <string name="onboarding_virustotal_key_hint">Προαιρετικό — μπορείτε να το προσθέσετε αργότερα στις Ρυθμίσεις.</string>
