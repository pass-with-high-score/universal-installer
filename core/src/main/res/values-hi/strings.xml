    <string name="onboarding_page1_title">कोई भी पैकेज स्थापित करें</string>
    <string name="onboarding_page1_desc">एपीके, एपीकेएस, एक्सएपीके और एपीकेएम प्रारूपों के लिए समर्थन। आसानी से स्प्लिट एपीके इंस्टॉल करें।</string>
    <string name="onboarding_page2_title">अपने ऐप्स प्रबंधित करें</string>
    <string name="onboarding_page2_desc">इंस्टॉल किए गए ऐप्स ब्राउज़ करें, अवांछित ऐप्स अनइंस्टॉल करें और अपने डिवाइस को सहजता से प्रबंधित करें।</string>
    <string name="onboarding_page3_title">स्थापना की अनुमति दें</string>
    <string name="onboarding_page3_desc">पैकेज इंस्टॉल करने के लिए, ऐप को अज्ञात स्रोतों से इंस्टॉल करने की अनुमति की आवश्यकता होती है। इसे प्रदान करने के लिए नीचे दिए गए बटन पर टैप करें।</string>
    <string name="permission_return_channel_name">ऐप पर लौटें</string>
    <string name="permission_return_channel_desc">सिस्टम सेटिंग्स में अनुमति देने के बाद ऐप पर वापस लौटने की अधिसूचना।</string>
    <string name="permission_return_title">अनुमति दी गई</string>
    <string name="permission_return_body">Universal Installer पर लौटने के लिए टैप करें।</string>
    <string name="onboarding_analytics_title">जो टूटता है उसे ठीक करने में मदद करें</string>
    <string name="onboarding_analytics_desc">हर फ़ोन पर ऐप इंस्टॉल करना अलग तरह से काम करता है, और क्या विफल होता है यह हमें तभी पता चलता है जब ऐप बताता है। यह बताता है कि इंस्टॉल सफल हुआ या नहीं और क्या ग़लत हुआ — यह कभी नहीं बताता कि आपने कौन-सा ऐप इंस्टॉल किया।</string>
    <string name="onboarding_analytics_switch">अनाम डायग्नोस्टिक्स साझा करें</string>
    <string name="onboarding_analytics_switch_sub">आप इसे कभी भी सेटिंग में बदल सकते हैं।</string>
    <string name="onboarding_virustotal_title">इंस्टॉल करने से पहले स्कैन करें</string>
    <string name="onboarding_virustotal_desc">इंस्टॉल स्क्रीन से ही 70+ एंटीवायरस इंजनों से किसी भी पैकेज की जाँच करें। इसके लिए एक मुफ़्त VirusTotal API कुंजी की आवश्यकता है।</string>
    <string name="onboarding_security_normal">सामान्य</string>
    <string name="onboarding_security_strict">सख्त</string>
    <string name="onboarding_security_normal_sub">\"इंस्टॉल करें\" मुख्य बटन बना रहेगा। जब चाहें तब स्कैन करें।</string>
    <string name="onboarding_security_strict_sub">\"स्कैन करें\" मुख्य बटन बन जाता है, और बिना स्कैन की गई फ़ाइलों को इंस्टॉल करने से पहले पुष्टि माँगी जाएगी।</string>
    <string name="onboarding_virustotal_get_key">मुफ़्त API कुंजी प्राप्त करें</string>
    <string name="onboarding_virustotal_key_label">VirusTotal API कुंजी</string>
