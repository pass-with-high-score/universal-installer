    <string name="install_error_blocked_title">Telepítés blokkolva</string>
    <string name="install_error_blocked_guidance">Az eszköz házirendje vagy biztonsági beállításai blokkolták a telepítést. Ellenőrizd, hogy engedélyezve vannak-e az ismeretlen források itt: Beállítások &gt; Alkalmazások &gt; Speciális hozzáférés.</string>
    <string name="install_error_conflict_title">Csomagütközés</string>
    <string name="install_error_conflict_guidance">Már telepítve van egy ütköző verzió. Előbb távolítsd el a meglévő alkalmazást, vagy kapcsold be a „Meglévő felülírása” opciót a telepítő beállításaiban.</string>
    <string name="install_blocked_by_blacklist">A(z) %1$s a blokkolt listádon szerepel, ezért nem lett telepítve. A telepítéshez távolítsd el innen: Beállítások → Blokkolt csomagok.</string>
    <string name="install_blocked_banner">Blokkolva — úgy döntöttél, hogy ezt a csomagot soha nem telepíted</string>
    <string name="install_blocked_unblock">Blokkolás feloldása</string>
    <string name="install_error_conflict_downgrade_guidance">Már egy újabb verzió van telepítve. Az Android csak akkor enged visszaléptetni, ha engedélyezed — kapcsold be a „Visszaléptetés engedélyezése” opciót a telepítő beállításaiban, vagy előbb távolítsd el a jelenlegi verziót. A „Meglévő felülírása” erre nem vonatkozik.</string>
    <string name="install_error_conflict_signature_guidance">A telepített alkalmazás más kulccsal van aláírva, ezért az Android nem tekinti ezt a fájlt frissítésnek. Előbb távolítsd el a meglévő alkalmazást — az adatai elvesznek. Ezt semmilyen telepítési opció nem tudja megkerülni.</string>
    <string name="install_error_incompatible_title">Nem kompatibilis csomag</string>
    <string name="install_error_incompatible_guidance">Ez az APK nem kompatibilis az eszközöddel. Lehet, hogy más CPU-architektúrát, Android-verziót vagy hiányzó hardverfunkciót igényel.</string>
    <string name="install_error_incompatible_sdk_title">Nem kompatibilis Android-verzió</string>
    <string name="install_error_incompatible_sdk_guidance">Ehhez az alkalmazáshoz újabb Android-verzió szükséges, mint ami az eszközödön fut.</string>
    <string name="install_error_incompatible_sdk_detailed_guidance">Ehhez az alkalmazáshoz Android %1$s (API %2$d) vagy újabb szükséges, de az eszközödön Android %3$s (API %4$d) fut.</string>
    <string name="install_error_incompatible_abi_title">Nem kompatibilis CPU-architektúra</string>
    <string name="install_error_incompatible_abi_guidance">Ez az APK nem kompatibilis az eszközöd CPU-architektúrájával (pl. 32 bites vs. 64 bites).</string>
    <string name="install_error_incompatible_feature_title">Hiányzó eszközfunkció</string>
    <string name="install_error_incompatible_feature_guidance">Ehhez az alkalmazáshoz olyan hardver- vagy rendszerfunkció szükséges, amelyet az eszközöd nem támogat.</string>
    <string name="install_error_invalid_title">Érvénytelen csomag</string>
    <string name="install_error_invalid_guidance">Az APK-fájl sérült vagy nem érvényes Android-csomag. Próbáld meg újra letölteni megbízható forrásból.</string>
    <string name="install_error_storage_title">Nincs elég tárhely</string>
    <string name="install_error_storage_guidance">Az eszközödön nincs elég szabad hely. Szabadíts fel tárhelyet itt: Beállítások &gt; Tárhely, majd próbáld újra.</string>
    <string name="install_error_timeout_title">Időtúllépés a telepítéskor</string>
    <string name="install_error_timeout_guidance">A telepítés túl sokáig tartott és megszakadt. Koppints az Újra gombra az újrapróbáláshoz.</string>
    <string name="install_error_unexpected_title">Váratlan hiba</string>
