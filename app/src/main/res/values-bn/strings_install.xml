    <string name="install_error_conflict_downgrade_guidance">একটি নতুন সংস্করণ ইতিমধ্যে ইনস্টল করা আছে। আপনি অনুমতি না দেওয়া পর্যন্ত Android ডাউনগ্রেড করতে অস্বীকার করে — ইনস্টলার বিকল্পে \"ডাউনগ্রেডের অনুমতি দিন\" চালু করুন, অথবা প্রথমে বর্তমান সংস্করণটি আনইনস্টল করুন। \"বিদ্যমান প্রতিস্থাপন করুন\" এটি কভার করে না।</string>
    <string name="install_error_conflict_signature_guidance">ইনস্টল করা অ্যাপটি একটি ভিন্ন কী দিয়ে স্বাক্ষরিত, তাই Android এই ফাইলটিকে একটি আপডেট হিসেবে বিবেচনা করবে না। প্রথমে বিদ্যমান অ্যাপটি আনইনস্টল করতে হবে — এর ডেটা মুছে যাবে। কোনো ইনস্টলার বিকল্প এটি বাইপাস করতে পারে না।</string>
    <string name="install_error_incompatible_title">অসঙ্গতিপূর্ণ প্যাকেজ</string>
