    <string name="setting_security_level_title">Poziom bezpieczeństwa</string>
    <string name="setting_security_normal">Normalny</string>
    <string name="setting_security_strict">Ścisły</string>
    <string name="setting_security_normal_sub">Zainstaluj jest przyciskiem głównym. VirusTotal nadal znajdziesz w szczegółach, gdy będzie potrzebny.</string>
    <string name="setting_security_strict_sub">Skanuj w VirusTotal staje się przyciskiem głównym, dopóki plik nie ma werdyktu, a instalacja czegoś nieprzeskanowanego wymaga potwierdzenia. Wymaga klucza API.</string>
