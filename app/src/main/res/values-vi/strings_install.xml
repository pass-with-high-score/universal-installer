    <string name="install_error_cancelled_guidance">Quá trình cài đặt đã bị người dùng hoặc hệ thống hủy. Nhấn Thử lại để thử lại.</string>
    <string name="install_error_blocked_title">Cài đặt bị chặn</string>
    <string name="install_error_blocked_guidance">Chính sách thiết bị hoặc cài đặt bảo mật của bạn đã chặn bản cài đặt này. Hãy kiểm tra xem các nguồn không xác định có được cho phép trong Cài đặt &gt; Ứng dụng &gt; Quyền truy cập đặc biệt hay không.</string>
    <string name="install_error_conflict_title">Xung đột gói</string>
    <string name="install_error_conflict_guidance">Một phiên bản xung đột đã được cài đặt. Trước tiên, hãy gỡ cài đặt ứng dụng hiện có hoặc bật \"Thay thế bản hiện tại\" trong các tùy chọn trình cài đặt.</string>
    <string name="install_blocked_by_blacklist">%1$s nằm trong danh sách chặn của bạn nên đã không được cài. Muốn cài thì gỡ nó khỏi Cài đặt → Gói bị chặn.</string>
    <string name="install_blocked_banner">Đã chặn — bạn đã chọn không bao giờ cài gói này</string>
    <string name="install_blocked_unblock">Bỏ chặn</string>
    <string name="install_error_conflict_downgrade_guidance">Một phiên bản mới hơn đã được cài. Android từ chối hạ cấp trừ khi bạn cho phép — hãy bật \"Cho phép hạ cấp\" trong tuỳ chọn trình cài đặt, hoặc gỡ bản hiện tại trước. \"Thay thế bản hiện tại\" không xử lý được trường hợp này.</string>
    <string name="install_error_conflict_signature_guidance">Ứng dụng đã cài được ký bằng khoá khác nên Android không coi file này là bản cập nhật. Hãy gỡ ứng dụng hiện có trước — dữ liệu của nó sẽ mất. Không tuỳ chọn nào của trình cài đặt vượt qua được điều này.</string>
    <string name="install_error_incompatible_title">Gói không tương thích</string>
    <string name="install_error_incompatible_guidance">APK này không tương thích với thiết bị của bạn. Nó có thể yêu cầu một kiến trúc CPU khác, phiên bản Android khác hoặc thiếu tính năng phần cứng.</string>
    <string name="install_error_incompatible_sdk_title">Phiên bản Android không tương thích</string>
    <string name="install_error_incompatible_sdk_guidance">Ứng dụng này yêu cầu phiên bản Android mới hơn phiên bản đang chạy trên thiết bị của bạn.</string>
    <string name="install_error_incompatible_sdk_detailed_guidance">Ứng dụng này yêu cầu Android %1$s (API %2$d) trở lên, nhưng thiết bị của bạn đang chạy Android %3$s (API %4$d).</string>
    <string name="install_error_incompatible_abi_title">Kiến trúc CPU không tương thích</string>
    <string name="install_error_incompatible_abi_guidance">APK này không tương thích với kiến trúc vi xử lý (CPU) của thiết bị (ví dụ 32-bit vs 64-bit).</string>
    <string name="install_error_incompatible_feature_title">Thiếu tính năng phần cứng</string>
    <string name="install_error_incompatible_feature_guidance">Ứng dụng này yêu cầu tính năng phần cứng hoặc hệ thống mà thiết bị của bạn không hỗ trợ.</string>
    <string name="install_error_invalid_title">Gói không hợp lệ</string>
    <string name="install_error_invalid_guidance">Tệp APK bị hỏng hoặc không phải là gói Android hợp lệ. Hãy thử tải xuống lại từ một nguồn đáng tin cậy.</string>
    <string name="install_error_storage_title">Không đủ dung lượng lưu trữ</string>
    <string name="install_error_storage_guidance">Thiết bị của bạn không có đủ dung lượng trống. Hãy giải phóng dung lượng trong Cài đặt &gt; Bộ nhớ và thử lại.</string>
    <string name="install_error_timeout_title">Hết thời gian cài đặt</string>
    <string name="install_error_timeout_guidance">Quá trình cài đặt mất quá nhiều thời gian và đã bị hủy. Nhấn Thử lại để thử lại.</string>
    <string name="install_error_unexpected_title">Lỗi không mong muốn</string>
    <string name="install_error_unexpected_guidance">Đã xảy ra lỗi không mong muốn: %s. Hãy thử khởi động lại ứng dụng hoặc thiết bị của bạn.</string>
    <string name="install_error_failed_title">Cài đặt thất bại</string>
    <string name="install_error_unknown_guidance">Đã xảy ra một lỗi không xác định. Nhấn Thử lại để thử lại.</string>
    <string name="install_error_unknown_guidance_short">Đã xảy ra một lỗi không xác định.</string>
    <string name="install_delete_source_failed">Đã cài đặt, nhưng không xoá được file APK. Ứng dụng chia sẻ file cho Universal Installer thường không cho phép xoá — hãy xoá trong trình quản lý file bạn đã mở nó.</string>
    <string name="install_error_miui_hint">Trên thiết bị Xiaomi, Redmi và POCO, tính năng tối ưu hóa MIUI/HyperOS thường âm thầm chặn việc cài đặt. Hãy mở Cài đặt &gt; Cài đặt bổ sung &gt; Tùy chọn nhà phát triển, tắt \"Tối ưu hóa MIUI\", cài đặt ứng dụng rồi bật lại. Khi đang tắt, giao diện hệ thống có thể bị lỗi hiển thị — khởi động lại điện thoại sẽ khắc phục.</string>
