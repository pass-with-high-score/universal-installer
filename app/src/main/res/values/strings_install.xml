    <string name="install_error_cancelled_guidance">The installation was cancelled by the user or system. Tap Retry to try again.</string>
    <string name="install_error_blocked_title">Installation blocked</string>
    <string name="install_error_blocked_guidance">Your device policy or security settings blocked this install. Check if unknown sources are allowed in Settings &gt; Apps &gt; Special access.</string>
    <string name="install_error_conflict_title">Package conflict</string>
    <string name="install_error_conflict_guidance">A conflicting version is already installed. Uninstall the existing app first, or enable \&quot;Replace existing\&quot; in the installer options.</string>
    <string name="install_blocked_by_blacklist">%1$s is on your blocked list, so it was not installed. Remove it in Settings → Blocked packages to install it.</string>
    <string name="install_blocked_banner">Blocked — you chose never to install this package</string>
    <string name="install_blocked_unblock">Unblock</string>
    <string name="install_error_conflict_downgrade_guidance">A newer version is already installed. Android refuses to downgrade unless you allow it — turn on \&quot;Allow downgrade\&quot; in the installer options, or uninstall the current version first. \&quot;Replace existing\&quot; does not cover this.</string>
    <string name="install_error_conflict_signature_guidance">The installed app is signed with a different key, so Android will not treat this file as an update. Uninstall the existing app first — its data will be lost. No installer option can bypass this.</string>
    <string name="install_error_incompatible_title">Incompatible package</string>
    <string name="install_error_incompatible_guidance">This APK is not compatible with your device. It may require a different CPU architecture, Android version, or missing hardware feature.</string>
    <string name="install_error_incompatible_sdk_title">Incompatible Android version</string>
    <string name="install_error_incompatible_sdk_guidance">This app requires a newer version of Android than the one running on your device.</string>
    <string name="install_error_incompatible_sdk_detailed_guidance">This app requires Android %1$s (API %2$d) or newer, but your device is running Android %3$s (API %4$d).</string>
    <string name="install_error_incompatible_abi_title">Incompatible CPU architecture</string>
    <string name="install_error_incompatible_feature_title">Missing device feature</string>
    <string name="install_error_incompatible_feature_guidance">This app requires a hardware or system feature that is not supported by your device.</string>
    <string name="install_error_invalid_title">Invalid package</string>
    <string name="install_error_invalid_guidance">The APK file is corrupted or not a valid Android package. Try downloading it again from a trusted source.</string>
    <string name="install_error_storage_title">Not enough storage</string>
    <string name="install_error_storage_guidance">Your device doesn\'t have enough free space. Free up storage in Settings &gt; Storage and try again.</string>
    <string name="install_error_timeout_title">Installation timed out</string>
    <string name="install_error_timeout_guidance">The installation took too long and was cancelled. Tap Retry to try again.</string>
    <string name="install_error_unexpected_title">Unexpected error</string>
    <string name="install_error_unexpected_guidance">An unexpected error occurred: %s. Try restarting the app or your device.</string>
    <string name="install_error_security_frp_title">Installation blocked by device security (FRP)</string>
    <string name="install_error_security_frp_guidance">Android is blocking package installation because the device is in Factory Reset Protection (FRP) or an active security setup state. Please complete your device account setup or security verification and try again.</string>
    <string name="install_error_failed_title">Installation failed</string>
    <string name="install_error_unknown_guidance">An unknown error occurred. Tap Retry to try again.</string>
    <string name="install_error_unknown_guidance_short">An unknown error occurred.</string>
    <string name="install_error_no_certificates_title">Unsigned or corrupted APK</string>
    <string name="install_error_no_certificates_guidance">This APK is not digitally signed or its certificate is corrupt. Android prevents installing unsigned apps. Try downloading an official release, or install using Shizuku/Root mode if this is a development or modded APK.</string>
    <string name="install_error_missing_split_title">Missing split APK files</string>
    <string name="install_error_missing_split_guidance">This package is an incomplete split APK (missing architecture, language, or resource splits). Please download the complete bundle (.apks, .xapk, .apkm) or merge it using AntiSplit.</string>
    <string name="install_error_security_title">Blocked by system security</string>
    <string name="install_error_security_guidance">Your device\'s system installer blocked this package with a SecurityException. Switching to Shizuku mode in Settings bypasses vendor restrictions and allows successful installation.</string>
    <string name="install_error_internal_title">System installer error</string>
    <string name="install_error_internal_guidance">The Android system package installer encountered an internal error. Retrying or switching to Shizuku mode in Settings usually resolves this issue.</string>
    <string name="install_error_suggest_shizuku_action">Try with Shizuku</string>
    <string name="install_delete_source_failed">Installed, but the APK file could not be deleted. Apps that share a file with Universal Installer often do not allow deleting it — remove it from the file manager you opened it with.</string>
    <string name="install_error_miui_hint">On Xiaomi, Redmi and POCO devices, MIUI/HyperOS optimization often blocks installs silently. Open Settings &gt; Additional settings &gt; Developer options, turn off \&quot;MIUI optimization\&quot;, install the app, then turn it back on. While it is off the system theme may look distorted — restarting the phone fixes that.</string>
    <string name="install_error_miui_shizuku_hint">On Xiaomi/HyperOS devices with Shizuku, enable \"Install via USB\" and \"USB debugging (Security settings)\" in Developer options (requires SIM and Mi Account). If issues persist, try switching Installer Mode to Default in Settings.</string>
