default_platform(:android)

# The watch build shares its package name with :app, so Play sees one listing with two form
# factors. Every upload lane here therefore ships the phone AAB alongside the watch AAB: a release
# containing only the watch artifact would leave phone users with nothing on that track.
PHONE_AAB = "app/build/outputs/bundle/playRelease/app-play-release.aab"
WEAR_AAB = "wearos/build/outputs/bundle/release/wearos-release.aab"

platform :android do

  desc "Run tests"
  lane :test do
    gradle(task: "test")
  end

  desc "Build watch debug APK"
  lane :build_debug do
    gradle(task: ":wearos:assembleDebug")
  end

  desc "Build watch release AAB for Play"
  lane :build_release do
    gradle(task: ":wearos:bundleRelease")
  end

  desc "Build watch release APK for GitHub distribution"
  lane :build_full_release do
    gradle(task: ":wearos:assembleRelease")
  end

  desc "Deploy phone + watch to internal testing track"
  lane :internal do
    deploy_both(track: "internal", skip_screenshots: true, release_status: "completed")
  end

  desc "Deploy phone + watch to closed testing track"
  lane :beta do
    deploy_both(track: "beta", skip_screenshots: true, release_status: "completed")
  end

  desc "Deploy phone + watch to production"
  lane :production do
    deploy_both(track: "production", skip_screenshots: false, release_status: "draft")
  end

  desc "Increment watch version code"
  lane :bump_version do |options|
    version_name = options[:version] || "1.0"
    build_gradle = File.read("../wearos/build.gradle.kts")
    current_code = build_gradle.match(/versionCode = (\d+)/)[1].to_i
    new_code = current_code + 1

    new_content = build_gradle.gsub(
      /versionCode = \d+/,
      "versionCode = #{new_code}"
    )
    new_content = new_content.gsub(
      /versionName = ".*"/,
      "versionName = \"#{version_name}\""
    )
    File.write("../wearos/build.gradle.kts", new_content)

    UI.success("✅ Watch bumped to versionCode=#{new_code}, versionName=#{version_name}")
  end

  private_lane :deploy_both do |options|
    gradle(task: ":app:bundlePlayRelease")
    gradle(task: ":wearos:bundleRelease")
    upload_to_play_store(
      track: options[:track],
      package_name: "app.pwhs.universalinstaller",
      aab_paths: [PHONE_AAB, WEAR_AAB],
      json_key: "fastlane/play-store-key.json",
      # One listing, so the store text comes from the phone's metadata.
      metadata_path: "./fastlane/metadata/android",
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: options[:skip_screenshots],
      skip_upload_changelogs: false,
      release_status: options[:release_status],
    )
  end
end
